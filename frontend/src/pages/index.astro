---
const zones = [
  ["Europe/London", "Лондон"],
  ["Europe/Moscow", "Москва"],
  ["Asia/Dubai", "Дубай"],
  ["Asia/Tokyo", "Токио"],
  ["Australia/Sydney", "Сидней"],
  ["America/New_York", "Нью-Йорк"],
  ["America/Los_Angeles", "Лос-Анджелес"],
  ["UTC", "UTC"],
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Мировое время</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alegreya:wght@500;700&family=Alegreya+Sans:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --paper: #f4f6f3;
        --ink: #1d2a2f;
        --muted: #5c6b70;
        --line: #c9d2ce;
        --blue: #2b4c9b;
        --marker: #fbe96b;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font:
          18px/1.5 "Alegreya Sans",
          sans-serif;
        font-variant-numeric: tabular-nums;
      }
      main {
        max-width: 760px;
        margin: 0 auto;
        padding: 56px 24px 96px;
      }

      h1,
      h2,
      .big {
        font-family: "Alegreya", serif;
        font-weight: 700;
      }
      h1 {
        font-size: 3.2rem;
        line-height: 1.05;
        margin: 0 0 10px;
      }
      h2 {
        font-size: 1.7rem;
        margin: 64px 0 4px;
      }
      .lead {
        max-width: 34em;
        color: var(--muted);
        margin: 0 0 40px;
      }
      .note {
        color: var(--muted);
        font-size: 0.95rem;
        margin: 0 0 16px;
      }

      /* Конвертер: поля без рамок, только линия снизу, как в бланке */
      form {
        border-top: 2px solid var(--ink);
        padding-top: 20px;
      }
      .row {
        display: flex;
        flex-wrap: wrap;
        gap: 20px 28px;
        align-items: flex-end;
      }
      label {
        display: flex;
        flex-direction: column;
        gap: 2px;
        font-size: 0.9rem;
        color: var(--muted);
      }
      input,
      select {
        font: inherit;
        font-size: 1.1rem;
        color: var(--ink);
        background: transparent;
        border: 0;
        border-bottom: 1px solid var(--ink);
        padding: 4px 2px;
        border-radius: 0;
      }
      select {
        padding-right: 6px;
      }
      button {
        font: inherit;
        font-weight: 700;
        color: #fff;
        background: var(--blue);
        border: 0;
        border-radius: 3px;
        padding: 9px 20px;
        cursor: pointer;
      }
      button:hover {
        background: #213c7a;
      }
      :focus-visible {
        outline: 2px solid var(--blue);
        outline-offset: 3px;
      }

      #result {
        margin-top: 28px;
        min-height: 5.5rem;
      }
      #result .big {
        font-size: 2.6rem;
        line-height: 1.1;
      }
      #result mark {
        background: linear-gradient(transparent 55%, var(--marker) 55%);
        color: inherit;
        padding: 0 4px;
        margin: 0 -4px;
      }
      #result .sub {
        color: var(--muted);
        margin-top: 6px;
      }
      #result .error {
        color: #a3261e;
      }

      /* Расписание: как табло, строки разделены линиями */
      .tz-pick {
        margin: 14px 0 6px;
        max-width: 260px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th {
        text-align: left;
        font-weight: 500;
        font-size: 0.9rem;
        color: var(--muted);
        padding: 8px 12px 8px 0;
        border-bottom: 2px solid var(--ink);
      }
      td {
        padding: 14px 12px 14px 0;
        vertical-align: top;
        border-bottom: 1px solid var(--line);
      }
      td .title {
        font-family: "Alegreya", serif;
        font-weight: 700;
        font-size: 1.2rem;
        line-height: 1.2;
      }
      td small {
        display: block;
        color: var(--muted);
        font-size: 0.9rem;
      }
      td.mine {
        font-weight: 700;
      }

      @media (max-width: 640px) {
        h1 {
          font-size: 2.4rem;
        }
        main {
          padding-top: 36px;
        }
        th:nth-child(2),
        td:nth-child(2) {
          display: none;
        }
      }
      @media (prefers-reduced-motion: no-preference) {
        button {
          transition: background 0.15s;
        }
      }
    </style>
  </head>

  <body>
    <main>
      <h1>Мировое время</h1>
      <p class="lead">
        Выберите время и два пояса, и сервис покажет, сколько будет там. Ниже
        расписание встреч с коллегами из других стран.
      </p>

      <form id="convert-form">
        <div class="row">
          <label
            >Дата и время
            <input
              type="datetime-local"
              id="time"
              value="2026-10-20T09:00"
              required
            />
          </label>
          <label
            >Где сейчас это время
            <select id="from">
              {
                zones.map(([value, name]) => (
                  <option value={value} selected={value === "Europe/London"}>
                    {name}
                  </option>
                ))
              }
            </select>
          </label>
          <label
            >Перевести в
            <select id="to">
              {
                zones.map(([value, name]) => (
                  <option value={value} selected={value === "Asia/Tokyo"}>
                    {name}
                  </option>
                ))
              }
            </select>
          </label>
          <button type="submit">Перевести</button>
        </div>
        <div id="result" aria-live="polite"></div>
      </form>

      <h2>Расписание встреч</h2>
      <p class="note">
        Данные берутся из базы данных PostgreSQL. Выберите свой пояс, и время в
        последней колонке пересчитается на бэкенде.
      </p>
      <label class="tz-pick"
        >Мой часовой пояс
        <select id="view-tz">
          {
            zones.map(([value, name]) => (
              <option value={value} selected={value === "Europe/Moscow"}>
                {name}
              </option>
            ))
          }
        </select>
      </label>

      <table>
        <thead>
          <tr><th>Встреча</th><th>У организатора</th><th>У вас</th></tr>
        </thead>
        <tbody id="meetings"><tr><td colspan="3">Загружаю…</td></tr></tbody>
      </table>
    </main>

    <script is:inline>
      const $ = (id) => document.getElementById(id);

      $("convert-form").addEventListener("submit", async (e) => {
        e.preventDefault();
        const query = new URLSearchParams({
          time: $("time").value,
          from: $("from").value,
          to: $("to").value,
        });
        try {
          const response = await fetch("/api/convert?" + query);
          const data = await response.json();
          $("result").innerHTML = data.error
            ? `<div class="error">${data.error}</div>`
            : `<div class="big"><mark>${data.to.text}</mark></div>
               <div class="sub">${data.to.offset}. Исходное время: ${data.from.text} (${data.from.offset})</div>`;
        } catch {
          $("result").innerHTML =
            '<div class="error">Не удалось связаться с сервером.</div>';
        }
      });

      async function loadMeetings() {
        try {
          const response = await fetch(
            "/api/meetings?tz=" + encodeURIComponent($("view-tz").value),
          );
          const rows = await response.json();
          $("meetings").innerHTML = Array.isArray(rows)
            ? rows
                .map(
                  (m) => `
                <tr>
                  <td><span class="title">${m.title}</span><small>${m.organizer}, ${m.city}. ${m.duration_min} мин</small></td>
                  <td>${m.organizer_time.text}<small>${m.organizer_time.offset}</small></td>
                  <td class="mine">${m.your_time.text}<small>${m.your_time.offset}</small></td>
                </tr>`,
                )
                .join("")
            : `<tr><td colspan="3">${rows.error || "Не удалось загрузить встречи."}</td></tr>`;
        } catch {
          $("meetings").innerHTML =
            '<tr><td colspan="3">Не удалось связаться с сервером.</td></tr>';
        }
      }

      $("view-tz").addEventListener("change", loadMeetings);
      loadMeetings();
      $("convert-form").requestSubmit();
    </script>
  </body>
</html>
